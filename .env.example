# Copy this file to .env and fill only the services you use. Never commit the
# resulting .env file. Android debug builds may embed these values; release
# builds never do.

TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
MDBLIST_API_KEY=
TRAKT_CLIENT_ID=
TRAKT_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
PROWLARR_URL=https://prowlarr.example.com
PROWLARR_API_KEY=
SUBDL_API_KEY=
REAL_DEBRID_API_TOKEN=
# Browser clients cannot use Veilid DNS/TXT bootstrap discovery. Set a direct
# WebSocket endpoint for local development or inject it at web build time.
# Use wss:// when the frontend is served over HTTPS.
VITE_VEILID_BOOTSTRAP=wss://bootstrap.example.com/ws
# Explicitly enables mock:// outside Vite development and loopback origins.
VITE_ENABLE_MOCK_VEILID=0
